# =============================================================================
# Campus Connect — Docker Production Environment Template (P7-12)
# =============================================================================
# Copy this file to .env.prod and fill in real values before running:
#   cp .env.docker .env.prod
#   docker compose --env-file .env.prod up -d --build
#
# NEVER commit .env.prod — it is listed in .gitignore.
# This template file (.env.docker) is safe to commit.
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Database name (created automatically on first start)
POSTGRES_DB=campus_connect

# PostgreSQL user (created automatically)
POSTGRES_USER=cc_user

# REQUIRED: Set a strong password before first deployment.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# ── Backend Security ──────────────────────────────────────────────────────────
# REQUIRED: Long random JWT signing secret.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_long_random_jwt_secret_key

JWT_ALGORITHM=HS256

# ── Application Environment ───────────────────────────────────────────────────
ENVIRONMENT=production

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# For local Docker deployment: http://localhost
# For custom domain: https://yourdomain.com
CORS_ORIGINS=http://localhost

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=15
RATE_LIMIT_DEFAULT_PER_MINUTE=60

# ── Trusted Proxies (for X-Forwarded-For IP extraction) ──────────────────────
# Docker internal subnet ranges — allows Nginx to pass client IP correctly.
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8

# ── Optional Email Domain Restriction ────────────────────────────────────────
# Leave empty to allow all email domains.
# Example: ALLOWED_EMAIL_DOMAINS=campus.edu,university.ac.in
ALLOWED_EMAIL_DOMAINS=

# ── Uvicorn Workers ───────────────────────────────────────────────────────────
# 2 workers is appropriate for a single host. Increase if CPU allows.
# NOTE: WebSocket connection state is in-memory per process.
# All WebSocket connections must land on the SAME worker.
# For multi-worker deployments, use a session-affinity/sticky-session load balancer.
UVICORN_WORKERS=1

# ── Frontend Port Binding ─────────────────────────────────────────────────────
# Host port that maps to Nginx container port 80.
HOST_PORT=80

