# Campus Connect — Environment Variables Example
# Copy this file to .env and fill in your own values.
# NEVER commit your real .env file to version control.

# PostgreSQL connection string
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/campus_connect

# JWT secret key — MUST be a long, random, cryptographically secure string in production.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-this-with-a-long-random-secret-key

# JWT signing algorithm — do not change unless you know what you are doing.
JWT_ALGORITHM=HS256

# Environment mode: development, production, or test
ENVIRONMENT=development

# Allowed CORS origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175

# Rate Limiting (in-memory sliding window, single instance)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=15
RATE_LIMIT_DEFAULT_PER_MINUTE=60

# Trusted reverse proxies for client IP extraction from X-Forwarded-For
TRUSTED_PROXIES=127.0.0.1,::1

# Optional institutional email domain allowlist (e.g. campus.edu)
ALLOWED_EMAIL_DOMAINS=
